# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are bundled into the app and are PUBLIC.
# Never put a service-role key or any secret here.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project URL and publishable (anon) key. Leave empty to run without a backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
