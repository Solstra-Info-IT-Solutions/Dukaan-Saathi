{
  "expo": {
    "name": "Dukaan Saathi",
    "slug": "dukaan-saathi",
    "scheme": "dukaansaathi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.dukaansaathi.app"
    },
    "android": {
      "package": "in.dukaansaathi.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Dukaan Saathi uses the camera to scan product barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dukaan Saathi uses your photos to attach expense receipts.",
          "cameraPermission": "Dukaan Saathi uses the camera to photograph expense receipts and scan barcodes.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dukaan Saathi uses the microphone only while you hold the voice button to add items to a bill.",
          "speechRecognitionPermission": "Speech is turned into item names to fill a bill. Audio is not saved.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
