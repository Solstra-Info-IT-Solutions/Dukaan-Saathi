{
  "name": "dukaan-saathi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/contracts/src/database.types.ts",
    "db:check:local": "node scripts/db-check-pglite.mjs",
    "db:fixtures": "node supabase/tests/generate-money-fixtures.mjs && node --no-warnings supabase/tests/generate-contract-checks.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run db:check:local"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "@electric-sql/pglite": "0.5.11"
  }
}
